{
    "version": 8,
    "configurePresets": [
        {
            "name": "gcc",
            "displayName": "GCC MinGW (Windows)",
            "description": "Using native Windows GCC/G++ from PATH with Ninja generator",
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_INSTALL_PREFIX": "${sourceDir}/install",
                "CMAKE_C_COMPILER": "gcc",
                "CMAKE_CXX_COMPILER": "g++",
                "CMAKE_BUILD_TYPE": "Debug"
            }
        }
    ]
}
